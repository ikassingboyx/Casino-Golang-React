# Copy to .env and fill in. Never commit .env.
# Docker (docker compose up) reads the "Docker" and "Shared" sections;
# running the backend directly (go run) reads "Shared" and "Local development".

# ---------------------------------------------------------------- Docker
# The address people open. Locally http://localhost; hosted, your domain
# with https, e.g. https://casino.example.com
PUBLIC_URL=http://localhost
# What Caddy serves: ":80" for plain HTTP (locally, or behind a load balancer
# that handles HTTPS), or your bare domain (casino.example.com) for automatic
# HTTPS certificates.
SITE_ADDRESS=:80
# Host ports for the web container.
HTTP_PORT=80
HTTPS_PORT=443
# Database password, used to create the database on first start.
# Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Image names, for pushing to a registry: <IMAGE_PREFIX>-backend:<IMAGE_TAG>
# IMAGE_PREFIX=ghcr.io/your-name/casino
# IMAGE_TAG=latest

# ---------------------------------------------------------------- Shared
# Required, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=168h

# OAuth apps; a provider is enabled when its client ID is set. Each provider's
# allowed redirect URI is <PUBLIC_URL>/api/auth/<provider>/callback (Docker)
# or <API_URL>/api/auth/<provider>/callback (local development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------- Local development
PORT=8080
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://casino:password@localhost:5432/casino_db?sslmode=disable
# Reverse proxies (IPs/CIDRs, comma-separated) allowed to set X-Forwarded-For.
TRUSTED_PROXIES=
GIN_MODE=debug
